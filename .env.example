# PostgreSQL connection used by Prisma.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/statussage

# NextAuth configuration. Generate a unique secret with: openssl rand -hex 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret

# Optional Google sign-in. Credentials sign-in remains available without these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Authorizes scheduled monitoring checks. Generate a different random value.
CRON_SECRET=replace-with-a-different-random-secret

# Required only for Stripe billing flows.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional build configuration used by next.config.js.
NEXT_DIST_DIR=.next
NEXT_OUTPUT_MODE=
